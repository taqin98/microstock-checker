    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "multer": "^1.4.5-lts.2",
    "sax": "^1.6.0",
    "sharp": "^0.33.5",
    "uuid": "^11.1.0"
  }
}
