{
  "platform": "freepik",
  "label": "Freepik",
  "jpg": {
    "minWidth": 3000,
    "minHeight": 3000,
    "mustBeRGB": true,
    "maxFileSizeMB": 50
  },
  "eps": {
    "requireOutlinedText": true,
    "allowEmbeddedRaster": false,
    "allowPlacedItems": false,
    "requireRGB": true,
    "requireCMYK": false,
    "requireObjectsInArtboard": true
  },
  "svg": {
    "requireOutlinedText": true,
    "allowEmbeddedRaster": false,
    "minWidth": 400,
    "minHeight": 400,
    "maxPathCount": 40000
  },
  "aiContent": {
    "checkTrademark": true,
    "checkSensitiveContent": true,
    "suggestKeywords": true,
    "maxKeywords": 50,
    "flagThreshold": "low"
  }
}
