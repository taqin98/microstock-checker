{
  "platform": "adobestock",
  "label": "Adobe Stock",
  "jpg": {
    "minWidth": 4000,
    "minHeight": 4000,
    "mustBeRGB": true,
    "maxFileSizeMB": 45
  },
  "eps": {
    "requireOutlinedText": true,
    "allowEmbeddedRaster": false,
    "allowPlacedItems": false,
    "requireRGB": true,
    "requireCMYK": false,
    "requireObjectsInArtboard": true
  },
  "svg": {
    "requireOutlinedText": true,
    "allowEmbeddedRaster": false,
    "minWidth": 400,
    "minHeight": 400,
    "maxPathCount": 50000
  },
  "aiContent": {
    "checkTrademark": true,
    "checkSensitiveContent": true,
    "suggestKeywords": true,
    "maxKeywords": 50,
    "flagThreshold": "medium"
  }
}
