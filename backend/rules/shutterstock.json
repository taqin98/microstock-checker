{
  "platform": "shutterstock",
  "label": "Shutterstock",
  "jpg": {
    "minWidth": 4000,
    "minHeight": 4000,
    "mustBeRGB": true,
    "maxFileSizeMB": 45
  },
  "eps": {
    "requireOutlinedText": true,
    "allowEmbeddedRaster": false,
    "allowPlacedItems": false,
    "requireRGB": false,
    "requireCMYK": false,
    "requireObjectsInArtboard": true
  },
  "svg": {
    "requireOutlinedText": true,
    "allowEmbeddedRaster": false,
    "minWidth": 400,
    "minHeight": 400,
    "maxPathCount": 50000
  },
  "aiContent": {
    "checkTrademark": true,
    "prohibitIntellectualProperty": true,
    "checkSensitiveContent": true,
    "prohibitAiGenerated": true,
    "suggestKeywords": true,
    "maxKeywords": 50,
    "flagThreshold": "medium"
  },
  "metadata": {
    "descriptionMaxLength": 200,
    "keywordMaxCount": 50,
    "categoryMaxCount": 2,
    "imageCategories": [
      "Abstract",
      "Animals/Wildlife",
      "Arts",
      "Backgrounds/Textures",
      "Beauty/Fashion",
      "Buildings/Landmarks",
      "Business/Finance",
      "Celebrities",
      "Education",
      "Food and drink",
      "Healthcare/Medical",
      "Holidays",
      "Industrial",
      "Interiors",
      "Miscellaneous",
      "Nature",
      "Objects",
      "Parks/Outdoor",
      "People",
      "Religion",
      "Science",
      "Signs/Symbols",
      "Sports/Recreation",
      "Technology",
      "Transportation",
      "Vintage"
    ]
  }
}
